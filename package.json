{
  "name": "terraform-playground",
  "version": "1.10.5",
  "description": "DivergeTerraform: Terraform, AWS e Azure no navegador, com acessibilidade para pessoas cegas, surdas e neurodivergentes",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "badges": "node scripts/gerar-badges.mjs",
    "lint": "eslint .",
    "conferir-build": "node scripts/conferir-build.mjs"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "codemirror": "^6.0.2",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "AGPL-3.0-or-later"
}
