{
  "name": "terraform-playground",
  "version": "1.14.4",
  "description": "DivergeTerraform: Terraform, AWS e Azure no navegador, com acessibilidade para pessoas cegas, surdas e neurodivergentes",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/conferir-segredo.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "badges": "node scripts/gerar-badges.mjs",
    "lint": "eslint .",
    "comuns": "node scripts/comuns.mjs",
    "comuns:copiar": "node scripts/comuns.mjs copiar",
    "comuns:comparar": "node scripts/comuns.mjs comparar",
    "conferir-build": "node scripts/conferir-build.mjs",
    "check": "astro check"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "codemirror": "^6.0.2",
    "pixi.js": "8.22.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "7.3.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "AGPL-3.0-or-later"
}
